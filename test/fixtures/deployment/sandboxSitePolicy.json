{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SiteBuckets",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::synthetic-sandbox-frontend",
        "arn:aws:s3:::synthetic-sandbox-docs"
      ]
    },
    {
      "Sid": "SiteObjects",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:DeleteObject", "s3:AbortMultipartUpload"],
      "Resource": [
        "arn:aws:s3:::synthetic-sandbox-frontend/*",
        "arn:aws:s3:::synthetic-sandbox-docs/*"
      ]
    },
    {
      "Sid": "SiteInvalidation",
      "Effect": "Allow",
      "Action": ["cloudfront:CreateInvalidation"],
      "Resource": [
        "arn:aws:cloudfront::123456789012:distribution/ESYNTHETICFRONTEND",
        "arn:aws:cloudfront::123456789012:distribution/ESYNTHETICDOCS"
      ]
    },
    {
      "Sid": "DocsPreflightAndWait",
      "Effect": "Allow",
      "Action": ["cloudfront:GetDistribution", "cloudfront:GetInvalidation"],
      "Resource": [
        "arn:aws:cloudfront::123456789012:distribution/ESYNTHETICDOCS"
      ]
    },
    {
      "Sid": "SiteObjectEncryption",
      "Effect": "Allow",
      "Action": ["kms:GenerateDataKey", "kms:Decrypt"],
      "Resource": [
        "arn:aws:kms:us-east-1:123456789012:key/11111111-1111-4111-8111-111111111111"
      ],
      "Condition": {
        "StringEquals": {
          "kms:CallerAccount": "123456789012",
          "kms:ViaService": "s3.us-east-1.amazonaws.com"
        },
        "StringLike": {
          "kms:EncryptionContext:aws:s3:arn": [
            "arn:aws:s3:::synthetic-sandbox-frontend/*",
            "arn:aws:s3:::synthetic-sandbox-docs/*"
          ]
        }
      }
    }
  ]
}
