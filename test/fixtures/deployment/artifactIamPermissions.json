      ],
      "Effect": "Allow",
      "Resource": "arn:aws:s3:::meeting-notes-prod-transcripts-123456789012",
      "Sid": "ArtifactTranscriptMetadata"
    },
    {
      "Action": [
        "kms:DescribeKey",
        "kms:GetKeyPolicy",
        "kms:GetKeyRotationStatus",
        "kms:ListResourceTags"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:kms:us-east-1:123456789012:key/22222222-2222-4222-8222-222222222222",
      "Sid": "ArtifactApplicationKeyMetadata"
    }
  ]
}
