{
  "name": "@chronote/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start:prod": "node scripts/start-prod.mjs",
    "dev": "tauri dev",
    "dev:prod": "node scripts/dev-prod.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 1420",
    "build": "tauri build",
    "build:ci": "tauri build --ci --no-sign",
    "build:smoke": "tauri build --debug --no-bundle --features synthetic-audio,test-hooks",
    "build:web": "vite build",
    "typecheck": "tsc --noEmit",
    "check": "cargo check --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "typescript": "^6.0.0",
    "vite": "^8.3.5"
  }
}
